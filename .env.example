# ============================================
# EMPLOYEE DIRECTORY - ENVIRONMENT VARIABLES
# ============================================

# ----------------------
# DATABASE CONFIGURATION
# ----------------------
# MySQL Database Connection Settings
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=employee_directory
DB_PORT=3306

# Database Connection Pool Settings
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# ----------------------
# SERVER CONFIGURATION
# ----------------------
# Port for the Node.js server
PORT=3000

# Node Environment (development | production)
NODE_ENV=development

# ----------------------
# CORS CONFIGURATION
# ----------------------
# Allowed origins (comma separated for multiple)
CORS_ORIGIN=http://localhost:3000,http://localhost:5500

# ----------------------
# API CONFIGURATION
# ----------------------
# API Base URL
API_BASE_URL=/api

# API Version
API_VERSION=v1

# ----------------------
# SECURITY (OPTIONAL)
# ----------------------
# JWT Secret (for future authentication)
# JWT_SECRET=your-super-secret-jwt-key-change-this

# Session Secret
# SESSION_SECRET=your-session-secret-change-this

# ----------------------
# LOGGING
# ----------------------
# Log level (error | warn | info | debug)
LOG_LEVEL=info

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# ----------------------
# EMAIL (OPTIONAL)
# ----------------------
# SMTP Configuration for sending emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@employee-directory.com

# ----------------------
# FILE UPLOAD (OPTIONAL)
# ----------------------
# Max file size for profile images (in bytes)
# MAX_FILE_SIZE=5242880

# Allowed file extensions
# ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp

# ----------------------
# RATE LIMITING (OPTIONAL)
# ----------------------
# Enable rate limiting
# ENABLE_RATE_LIMIT=true
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# ----------------------
# CACHE (OPTIONAL)
# ----------------------
# Enable Redis cache
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=3600

# ----------------------
# FEATURE FLAGS
# ----------------------
# Enable/disable features
# ENABLE_EMPLOYEE_EXPORT=true
# ENABLE_BULK_IMPORT=false
# ENABLE_ANALYTICS=false

# ----------------------
# ERROR REPORTING (OPTIONAL)
# ----------------------
# Sentry DSN for error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/12345

# ----------------------
# DEVELOPMENT ONLY
# ----------------------
# Auto-create database tables on startup
AUTO_MIGRATE=true

# Seed database with sample data on startup
SEED_DATABASE=true

# Enable debug mode
DEBUG=false