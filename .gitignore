# ============================================
# EMPLOYEE DIRECTORY - GIT IGNORE FILE
# ============================================

# ----------------------
# DEPENDENCIES
# ----------------------
# Node.js dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# ----------------------
# ENVIRONMENT FILES
# ----------------------
# Environment variables (sensitive data)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# ----------------------
# LOGS
# ----------------------
# Log files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----------------------
