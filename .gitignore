__pycache__/
*.py[cod]
*.so
.Python

# Ruby
Gemfile.lock
.bundle/

# Java
*.class
*.jar

# ----------------------
# PROJECT SPECIFIC
# ----------------------
# Uploaded profile images
public/uploads/
storage/app/public/

