dist/
build/
out/
.next/
.nuxt/
.vuepress/dist/

# Compiled files
*.min.js
*.min.css
*.map

# ----------------------
# DATABASE
# ----------------------
# Database files
*.sqlite
*.sqlite3
*.db
*.mdb
*.accdb
*.sql.bak

# Database dumps (except schema)
*.sql
!database.sql
!schema.sql

